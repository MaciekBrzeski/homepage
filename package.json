{
  "name": "homepage",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "assemble": "node scripts/assemble.mjs",
    "build:site": "ng build && node scripts/assemble.mjs",
    "serve": "node scripts/serve.mjs out",
    "format": "prettier --write src e2e scripts playwright.config.ts",
    "format:check": "prettier --check src e2e scripts playwright.config.ts",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck:e2e && ng test --watch=false && npm run build:site -- --skip-games && playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.12.0",
    "@types/three": "^0.187.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
